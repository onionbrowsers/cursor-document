#!/usr/bin/env bash
# Git post-commit hook：每次 commit 后，将 .cursor 目录的变更同步推送到 GitHub
# 由 git config core.hooksPath .cursor/scripts/git-hooks 激活

SYNC_DEBOUNCE_SECONDS="${CURSOR_SYNC_DEBOUNCE_SECONDS:-20}"
PUSH_TIMEOUT_SECONDS="${CURSOR_SYNC_PUSH_TIMEOUT_SECONDS:-120}"

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
CURSOR_DIR="$PROJECT_ROOT/.cursor"

if [[ ! -d "$CURSOR_DIR/.git" ]]; then
  exit 0
fi

GIT_DIR="$CURSOR_DIR/.git"
LOCK_DIR="$GIT_DIR/cursor-sync.lock"
LOG_FILE="$GIT_DIR/cursor-sync.log"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

run_with_timeout() {
  local timeout_seconds="$1"
  shift

  if command -v timeout >/dev/null 2>&1; then
    timeout "$timeout_seconds" "$@"
    return $?
  fi

  if command -v perl >/dev/null 2>&1; then
    perl -e 'alarm shift; exec @ARGV' "$timeout_seconds" "$@"
    return $?
  fi

  "$@"
}

(
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    log "已有同步任务运行，跳过 post-commit 触发"
    exit 0
  fi

  trap 'rm -rf "$LOCK_DIR"' EXIT

  log "收到 post-commit 触发，${SYNC_DEBOUNCE_SECONDS}s 后汇总同步"
  sleep "$SYNC_DEBOUNCE_SECONDS"

  cd "$CURSOR_DIR" || {
    log "无法进入 Cursor 配置目录: $CURSOR_DIR"
    exit 0
  }

  git add -A
  if git diff --staged --quiet; then
    log "无暂存变更，跳过 post-commit commit/push"
    exit 0
  fi

  if ! git commit -m "chore: 同步 .cursor 变更（触发自 post-commit）" >> "$LOG_FILE" 2>&1; then
    log "post-commit git commit 失败，请检查仓库状态"
    exit 0
  fi

  log "post-commit 开始 push origin main，超时时间 ${PUSH_TIMEOUT_SECONDS}s"
  if run_with_timeout "$PUSH_TIMEOUT_SECONDS" git push origin main >> "$LOG_FILE" 2>&1; then
    log "post-commit push 成功"
    exit 0
  fi

  PUSH_EXIT_CODE=$?
  log "post-commit push 失败或超时，退出码: $PUSH_EXIT_CODE；可手动执行：git -C \"$CURSOR_DIR\" push origin main"
) &
