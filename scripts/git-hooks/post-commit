#!/usr/bin/env bash
# Git post-commit hook：每次 commit 后，将 .cursor 目录的变更同步推送到 GitHub
# 由 git config core.hooksPath .cursor/scripts/git-hooks 激活

SYNC_DEBOUNCE_SECONDS="${CURSOR_SYNC_DEBOUNCE_SECONDS:-20}"
PUSH_TIMEOUT_SECONDS="${CURSOR_SYNC_PUSH_TIMEOUT_SECONDS:-120}"
export LANG="${LANG:-en_US.UTF-8}"
export LC_ALL="${LC_ALL:-en_US.UTF-8}"

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
CURSOR_DIR="$PROJECT_ROOT/.cursor"

if [[ ! -d "$CURSOR_DIR/.git" ]]; then
  exit 0
fi

GIT_DIR="$CURSOR_DIR/.git"
LOCK_DIR="$GIT_DIR/cursor-sync.lock"
LOG_FILE="$GIT_DIR/cursor-sync.log"

log() {
  printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >> "$LOG_FILE"
}

run_with_timeout() {
  local timeout_seconds="$1"
  shift

  if command -v timeout >/dev/null 2>&1; then
    timeout "$timeout_seconds" "$@"
    return $?
  fi

  if command -v perl >/dev/null 2>&1; then
    perl -e 'alarm shift; exec @ARGV' "$timeout_seconds" "$@"
    return $?
  fi

  "$@"
}

(
  if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    log "sync already running; skip post-commit trigger"
    exit 0
  fi

  trap 'rm -rf "$LOCK_DIR"' EXIT

  log "post-commit trigger received; sync after ${SYNC_DEBOUNCE_SECONDS}s debounce"
  sleep "$SYNC_DEBOUNCE_SECONDS"

  cd "$CURSOR_DIR" || {
    log "failed to enter cursor config dir: $CURSOR_DIR"
    exit 0
  }

  git add -A
  if git diff --staged --quiet; then
    log "no staged changes; skip post-commit commit/push"
    exit 0
  fi

  if ! git commit -m "chore: 同步 .cursor 变更（触发自 post-commit）" >> "$LOG_FILE" 2>&1; then
    log "post-commit git commit failed; check repository status"
    exit 0
  fi

  log "post-commit start push origin main; timeout=${PUSH_TIMEOUT_SECONDS}s"
  run_with_timeout "$PUSH_TIMEOUT_SECONDS" git push origin main >> "$LOG_FILE" 2>&1
  PUSH_EXIT_CODE=$?

  if [[ "$PUSH_EXIT_CODE" -eq 0 ]]; then
    log "post-commit push succeeded"
    exit 0
  fi

  log "post-commit push failed or timed out; exit_code=$PUSH_EXIT_CODE; manual command: git -C \"$CURSOR_DIR\" push origin main"
) &
